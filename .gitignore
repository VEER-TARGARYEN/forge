# compiled binaries (root only - do NOT match the cmd/forge source dir)
/forge
/forge.exe
*.test.exe
/ptcheck.exe

# build/test scratch
.gotmp/
bench-*.json

# forge runtime state (never commit - may contain keys or large models)
/.forge/

# editor / OS
.vscode/
.idea/
*.swp
.DS_Store
# Staged by mkdist immediately before the installer is compiled, and cleared
# straight after. A committed copy would be a stale binary in the tree.
/cmd/forge-setup/payload/*
!/cmd/forge-setup/payload/.gitkeep
/dist/
